<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="www.springframework.org"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="www.springframework.org"
    xmlns:mvc="www.springframework.org"
    xsi:schemaLocation="
        www.springframework.org
        www.springframework.org/spring-beans.xsd
        www.springframework.org
        www.springframework.org/spring-context.xsd
        www.springframework.org
        www.springframework.org/spring-mvc.xsd">

    <!-- Scans for the @Controller, @Service etc. in the specified package -->
    <context:component-scan base-package="your.controller.package.name" />

    <!-- Enables the Spring MVC @Controller programming model -->
    <mvc:annotation-driven />

    <!-- Configures the View Resolver -->
    <bean id="viewResolver"
          class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/" />
        <property name="suffix" value=".jsp" />
    </bean>

</beans>
