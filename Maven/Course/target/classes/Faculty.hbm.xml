<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
  <hibernate-mapping>
    <class name="com.demo.beans.Faculty" >
       <id name="fid">
           <generator class="assigned"></generator>
       </id>
       <property name="fname" type="string" column="fname" not-null="true"></property>
       <property name="skills" type="string" column="skills" ></property>
    </class>
    
  </hibernate-mapping>