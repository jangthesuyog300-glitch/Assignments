package com.demo.service;

import com.demo.dao.EmpDao;
import com.demo.dao.EmpDaoImpl;
import com.demo.beans.*;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.*;

public class EmpServiceImpl implements EmpService {
	EmpDao edao;
	

	public EmpServiceImpl() {
		edao =new EmpDaoImpl();
	}

	public boolean AddEmp() {
		Scanner sc=new Scanner(System.in);
			System.out.println("Enter the Employee Name ");
			String name=sc.next();
			System.out.println("Enter the salary");
			double Salary =sc.nextDouble();
			System.out.println("Enter the hireDate (dd/MM/yyyy)");
			String dt = sc.next();
			LocalDate ldt = LocalDate.parse(dt,DateTimeFormatter.ofPattern("dd/MM/yyyy"));
			Employee e =new Employee(name,Salary,ldt);
			
		
		return edao.save(e);
	}

	@Override
	public boolean addProject() {
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter the Project Name ");
		String name=sc.next();
		System.out.println("Enter the StartDate (dd/MM/yyyy)");
		String dt = sc.next();
		LocalDate ldt = LocalDate.parse(dt,DateTimeFormatter.ofPattern("dd/MM/yyyy"));
		Project p = new Project(name,ldt);
		
		return edao.savep(p);
	}

