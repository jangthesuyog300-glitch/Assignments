package com.demo.test;

import java.time.LocalDate;
import java.util.Set;
import java.util.HashSet;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.cfg.Configuration;

import com.demo.beans.Project;
import com.demo.beans.Employee;

public class TestManyToMany {

	public static void main(String[] args) {

		SessionFactory sf = new Configuration().configure().buildSessionFactory();
		Session session=sf.openSession();
		Transaction tr= session.beginTransaction();
		
		Employee e=new Employee(1,"shruti",12000,LocalDate.of(2025, 8, 21));
		Employee e1=new Employee("Suyog",200000,LocalDate.of(2025,8,18));
		Employee e2=new Employee("Vipul",1200,LocalDate.of(2025, 8, 21));
		Employee e3=new Employee("suhani",155000,LocalDate.of(2025, 8, 21));
		Employee e4=new Employee(14,"shrushti",125000,LocalDate.of(2025, 8, 21));
		
		Set<Employee> pset=new HashSet<>();
		pset.add(e1);
		pset.add(e3);
		pset.add(e4);
		Set<Employee> pset1=new HashSet<>();
		pset1.add(e1);
		pset1.add(e);
		pset1.add(e4);
		pset1.add(e2);
		
		

		Project p=new Project(1,"menuPro",LocalDate.of(2025, 12, 3),pset);
		Project p1=new Project("Movie Ticket",LocalDate.of(2025, 11, 30),pset1);
		Set<Project> ppset=new HashSet<>();
		ppset.add(p);
		ppset.add(p1);
		Set<Project> ppset1=new HashSet<>();
		ppset.add(p);
		Set<Project> ppset2=new HashSet<>();
		ppset.add(p1);
		
		e.setPset(ppset2);
		e1.setPset(ppset);
		e2.setPset(ppset2);
		e3.setPset(ppset1);
		e4.setPset(ppset);
		
		
		
		session.save(p);
		session.save(p1);
		
		
		
		
		tr.commit();
		session.close();
		sf.close();
	}

}
